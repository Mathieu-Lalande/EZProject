# Copier en .env (non versionné) pour surcharger les valeurs locales de docker compose.
DB_USERNAME=ezproject
DB_PASSWORD=changez-moi

# local = comptes de démo ; prod = aucun compte de démo, cookie Secure (HTTPS obligatoire)
SPRING_PROFILES_ACTIVE=local
SEED_DEMO=true
DEMO_PASSWORD=demo1234

# Premier propriétaire : créé seulement si la base est vide (mettre SEED_DEMO=false pour partir d'une base vierge)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_ORGANIZATION=Mon organisation

# Double authentification : clé AES-256 en Base64 (openssl rand -base64 32). Obligatoire en production.
MFA_ENCRYPTION_KEY=
# Jeton d'accès à /actuator/prometheus (vide = métriques désactivées)
METRICS_TOKEN=
# Plusieurs instances : compteurs anti-abus et temps réel partagés via Redis (docker compose --profile redis up)
REDIS_ENABLED=false
# Durée d'inactivité avant expiration de session (ex. 30m, 8h)
SESSION_TIMEOUT=8h
